# Base de datos (SQLite por defecto, funciona sin instalar nada más).
# Para usar Postgres en producción, cambia el provider en prisma/schema.prisma
# y pon aquí la cadena de conexión de Postgres.
DATABASE_URL="file:./dev.db"

# Contraseña del panel de administración (cámbiala).
ADMIN_PASSWORD="cambia-esta-clave"

# Clave secreta para firmar la cookie de sesión del admin (usa un valor largo y aleatorio).
SESSION_SECRET="cambia-esta-clave-tambien-larga-y-aleatoria"
