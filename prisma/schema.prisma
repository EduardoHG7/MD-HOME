generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(cuid())
  nombre    String
  slug      String   @unique
  logo      String?
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())

  usuarios       UserTenant[]
  eventos        Evento[]
  puestos        Puesto[]
  aplicantes     Aplicante[]
  venues         Venue[]
  tarifas        Tarifa[]
  patrocinadores Patrocinador[]
  eventosAsignados EventoTenant[]
  clientes       Cliente[]
  proveedores    Proveedor[]
  materialesPM   MaterialPM[]
  productosPM    ProductoParametricoPM[]
  cotizacionesPM CotizacionPM[]
  aprobacionConfig AprobacionConfig?

  @@map("tenants")
}

model UserTenant {
  id       String @id @default(cuid())
  userId   String
  tenantId String
  role     String @default("USER")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@map("user_tenants")
}

// Role: ADMIN | USER | CONTABILIDAD | OPERACIONES
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  image        String?
  telefono     String?
  role         String   @default("USER")
  isSuperAdmin Boolean  @default(false)
  puedeVerFinanzas Boolean @default(false) // acceso al dashboard de Finanzas Panatickets (ADMIN/isSuperAdmin siempre lo tienen)
  firmaImagen  String?  // Data URL (PNG) de la firma para estampar en contratos
  createdAt    DateTime @default(now())

  tenants                  UserTenant[]
  solicitudes              Solicitud[]
  solicitudesAprobadas     Solicitud[]   @relation("SolicitudAprobador")
  facturas                 Factura[]
  lineasAsignadas          PresupuestoLinea[]
  cotizaciones             Cotizacion[]
  cotizacionesAprobadas    Cotizacion[]  @relation("CotizacionAprobador")
  cajasMenuda              CajaMenuda[]
  cajasMenudaAprobadas     CajaMenuda[]  @relation("CajaMenudaAprobador")
  cajasMenudaPagadas       CajaMenuda[]  @relation("CajaMenudaPagador")
  eventosDocsAsignados     Evento[]      @relation("EventoDocsResponsable")
  documentosSubidos        EventoDocumento[]
  contratosSubidos         EventoContrato[] @relation("ContratoSubidor")
  contratosFirmados        EventoContrato[] @relation("ContratoFirmante")
  cotizacionesPMCreadas       CotizacionPM[] @relation("CotizacionPMCreador")
  cotizacionesPMAprobadas     CotizacionPM[] @relation("CotizacionPMAprobador")
  cotizacionesPMCostoRealAprobado CotizacionPM[] @relation("CotizacionPMCostoRealAprobador")
  aprobacionRoles AprobacionConfigUsuario[]

  @@map("users")
}

// EstadoContrato: PENDIENTE_FIRMA | FIRMADO
model EventoContrato {
  id            String    @id @default(cuid())
  eventoId      String    @unique
  archivoPath   String    // PDF original en SharePoint
  archivoNombre String
  firmadoPath   String?   // PDF con la firma del gerente general estampada
  estado        String    @default("PENDIENTE_FIRMA")
  subidoPorId   String
  firmadoPorId  String?
  firmadoAt     DateTime?
  createdAt     DateTime  @default(now())

  evento     Evento @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  subidoPor  User   @relation("ContratoSubidor", fields: [subidoPorId], references: [id])
  firmadoPor User?  @relation("ContratoFirmante", fields: [firmadoPorId], references: [id])

  @@map("evento_contratos")
}

// Datos fiscales para el formulario de comprobantes electrónicos (Panatickets)
// organizacion: JURIDICA | NATURAL
model FormularioComprobantes {
  id              String   @id @default(cuid())
  eventoId        String   @unique
  razonSocial     String?
  nombreComercial String?
  rucDv           String?
  direccion       String?
  provincia       String?
  distrito        String?
  corregimiento   String?
  telefonos       String?
  organizacion    String?
  correoEnvio     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  evento Evento @relation(fields: [eventoId], references: [id], onDelete: Cascade)

  @@map("formularios_comprobantes")
}

// TipoDocumento: CONTRATO | SEGURO | FIANZA | PERMISO | OTRO
model EventoDocumento {
  id            String   @id @default(cuid())
  eventoId      String
  tipo          String
  nombre        String?
  archivoPath   String
  archivoNombre String
  subidoPorId   String
  createdAt     DateTime @default(now())

  evento    Evento @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  subidoPor User   @relation(fields: [subidoPorId], references: [id])

  @@map("evento_documentos")
}

// TipoTarifa: DIARIA | QUINCENAL | MENSUAL
model Tarifa {
  id           String   @id @default(cuid())
  tipo         String
  precioPorDia Float
  tenantId     String?
  updatedAt    DateTime @updatedAt

  tenant      Tenant? @relation(fields: [tenantId], references: [id])
  solicitudes Solicitud[]

  @@map("tarifas")
}

model Venue {
  id        String   @id @default(cuid())
  nombre    String
  direccion String?
  tenantId  String?
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())

  tenant  Tenant? @relation(fields: [tenantId], references: [id])
  eventos Evento[]

  @@map("venues")
}

// TipoEvento: PROPIO | CONTRATADO | COPRODUCCION
// EstadoEvento: POR_INICIAR | ACTIVO | COMPLETADO | CANCELADO
model Evento {
  id               String   @id @default(cuid())
  nombre           String
  descripcion      String?
  fechaInicio      DateTime
  fechaFin         DateTime
  estado           String   @default("ACTIVO")
  tipoEvento       String?  // PROPIO | CONTRATADO | COPRODUCCION
  venueId          String?
  tenantId         String?
  tieneSocio       Boolean  @default(false)
  nombreSocio      String?
  montajeInicio    DateTime?
  desmontajeFin    DateTime?
  docsResponsableId String?
  expedienteNotificado Boolean @default(false) // ya se avisó a admin que el expediente Panatickets está listo para firma
  // Expediente Panatickets: logística (aplica/no aplica) y cierre (comentario + aprobación admin)
  logisticaAplica  Boolean?
  cierreComentario String?
  cierreAprobado   Boolean  @default(false)
  cierreAprobadoPor String?  // nombre o correo del admin que aprobó
  cierreAprobadoEn DateTime?
  createdAt        DateTime @default(now())

  solicitudes  Solicitud[]
  asignaciones AsignacionAplicante[]
  facturas     Factura[]
  cajasMenuda  CajaMenuda[]
  venue        Venue?        @relation(fields: [venueId], references: [id])
  tenant       Tenant?       @relation(fields: [tenantId], references: [id])
  presupuesto  Presupuesto?
  docsResponsable User?      @relation("EventoDocsResponsable", fields: [docsResponsableId], references: [id])
  documentos   EventoDocumento[]
  contrato     EventoContrato?
  cotizacionesPM CotizacionPM[]
  formularioComprobantes FormularioComprobantes?
  tenants      EventoTenant[]

  @@map("eventos")
}

// Un evento puede pertenecer a varias empresas del holding
model EventoTenant {
  id       String @id @default(cuid())
  eventoId String
  tenantId String

  evento Evento @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([eventoId, tenantId])
  @@map("evento_tenants")
}

model Presupuesto {
  id              String   @id @default(cuid())
  eventoId        String   @unique
  artista         String?
  pais            String?
  ciudad          String?
  promotor        String?
  moneda          String   @default("USD")
  exchangeRate    Float    @default(1)
  numShows        Int      @default(1)
  artistGuarantee  Float    @default(0)
  artistBackend    Boolean  @default(false)
  artistBackendPct Float    @default(80)
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())

  evento              Evento                @relation(fields: [eventoId], references: [id])
  categorias          PresupuestoCategoria[]
  ticketZonas         TicketZona[]
  patrocinios         Patrocinio[]
  boletosVendidosReal BoletosVendidosReal[]
  socios              SocioPresupuesto[]

  @@map("presupuestos")
}

model SocioPresupuesto {
  id            String @id @default(cuid())
  presupuestoId String
  nombre        String
  porcentaje    Float  @default(0)
  orden         Int    @default(0)

  presupuesto Presupuesto @relation(fields: [presupuestoId], references: [id], onDelete: Cascade)

  @@map("socios_presupuesto")
}

model PresupuestoCategoria {
  id             String   @id @default(cuid())
  presupuestoId  String
  nombre         String
  orden          Int      @default(0)
  createdAt      DateTime @default(now())

  presupuesto Presupuesto        @relation(fields: [presupuestoId], references: [id], onDelete: Cascade)
  lineas      PresupuestoLinea[]

  @@map("presupuesto_categorias")
}

model PresupuestoLinea {
  id             String   @id @default(cuid())
  categoriaId    String
  descripcion    String
  nota           String?
  montoLocal     Float    @default(0)
  montoUsd       Float    @default(0)
  orden          Int      @default(0)
  confianza      String?  // HIGH | LOW
  asignadoAId    String?  // userId responsable de cargar cotizaciones

  categoria   PresupuestoCategoria @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  asignadoA   User?                @relation(fields: [asignadoAId], references: [id])
  cotizaciones Cotizacion[]

  @@map("presupuesto_lineas")
}

// Estado: PENDIENTE | APROBADA | RECHAZADA
model Cotizacion {
  id          String   @id @default(cuid())
  lineaId     String
  creadoPorId String
  concepto    String?  // Agrupa cotizaciones del mismo sub-rubro (ej: "Comida", "Bebidas")
  descripcion String?
  estado      String   @default("PENDIENTE")
  notaAdmin   String?
  montoTotal  Float    @default(0)
  // Archivo adjunto de la cotización (PDF/imagen)
  archivoUrl  String?
  archivoNombreCot String?
  // Factura real subida después de aprobación
  facturaUrl        String?
  facturaNumero     String?
  facturaProveedor  String?
  facturaFechaEmision String?
  facturaFechaPago  String?
  facturaSubtotal   Float?
  facturaItbms      Float?
  facturaTotal      Float?
  facturaSubida     Boolean  @default(false)
  aprobadaPorId     String?
  aprobadaEn        DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  linea       PresupuestoLinea   @relation(fields: [lineaId], references: [id], onDelete: Cascade)
  creadoPor   User               @relation(fields: [creadoPorId], references: [id])
  aprobadaPor User?              @relation("CotizacionAprobador", fields: [aprobadaPorId], references: [id])
  facturas    CotizacionFactura[]

  @@map("cotizaciones")
}

model CotizacionFactura {
  id           String @id @default(cuid())
  cotizacionId String
  descripcion  String
  proveedor    String?
  monto        Float  @default(0)
  archivoNombre String?

  cotizacion Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)

  @@map("cotizacion_facturas")
}

model BoletosVendidosReal {
  id            String @id @default(cuid())
  presupuestoId String
  zona          String
  vendidos      Int    @default(0)
  precio        Float  @default(0)
  orden         Int    @default(0)

  presupuesto Presupuesto @relation(fields: [presupuestoId], references: [id], onDelete: Cascade)

  @@map("boletos_vendidos_real")
}

model TicketZona {
  id             String   @id @default(cuid())
  presupuestoId  String
  scaling        String?
  zona           String
  capacity       Int      @default(0)
  killsBlocks    Int      @default(0)
  comps          Int      @default(0)
  ticketPriceLocal Float  @default(0)
  ticketPriceUsd   Float  @default(0)
  orden          Int      @default(0)

  presupuesto Presupuesto @relation(fields: [presupuestoId], references: [id], onDelete: Cascade)

  @@map("ticket_zonas")
}

model Patrocinador {
  id             String   @id @default(cuid())
  nombre         String
  categoria      String?  // ALCOHOL | BANCO | COMIDA_RAPIDA | AEROLINEA | HOTEL | MODA | RENTAL_CAR
  tenantId       String?
  contratoPath   String?
  contratoNombre String?
  activo         Boolean  @default(true)
  createdAt      DateTime @default(now())

  tenant      Tenant? @relation(fields: [tenantId], references: [id])
  patrocinios Patrocinio[]

  @@map("patrocinadores")
}

// Registro de clientes y proveedores de Print Media PTY (tenant "printmediapty")
// — no aplica a las demás empresas.
model Cliente {
  id                        String   @id @default(cuid())
  tenantId                  String?
  nombreEmpresa             String
  rucDv                     String
  nombreRepresentanteLegal  String
  nombreContacto            String
  telefono                  String
  correo                    String
  direccion                 String
  avisoOperacionesPath      String?
  avisoOperacionesNombre    String?
  cedulaRepPath             String?
  cedulaRepNombre           String?
  activo                    Boolean  @default(true)
  createdAt                 DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id])
  cotizacionesPM CotizacionPM[]

  @@map("clientes")
}

model Proveedor {
  id                        String   @id @default(cuid())
  tenantId                  String?
  nombreEmpresa             String
  rucDv                     String
  nombreRepresentanteLegal  String
  nombreContacto            String
  telefono                  String
  correo                    String
  direccion                 String
  avisoOperacionesPath      String?
  avisoOperacionesNombre    String?
  cedulaRepPath             String?
  cedulaRepNombre           String?
  nombreBanco               String
  tipoCuenta                String
  numeroCuenta              String
  activo                    Boolean  @default(true)
  createdAt                 DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@map("proveedores")
}

model Patrocinio {
  id              String   @id @default(cuid())
  presupuestoId   String
  patrocinadorId  String?
  nombre          String
  tipo            String?  // ACTIVACION | BTL | BRANDING
  tipoPago        String?  // CANJE | EFECTIVO
  montoLocal      Float    @default(0)
  montoUsd        Float    @default(0)
  notas           String?
  boletos         Json?    // [{zona, cantidad, precioUsd}] — informativo, no afecta ganancia
  esReal          Boolean  @default(false) // false=presupuestado, true=real cobrado

  presupuesto  Presupuesto   @relation(fields: [presupuestoId], references: [id], onDelete: Cascade)
  patrocinador Patrocinador? @relation(fields: [patrocinadorId], references: [id])

  @@map("patrocinios")
}

// EstadoSolicitud: PENDIENTE | APROBADA | RECHAZADA
model Solicitud {
  id            String   @id @default(cuid())
  eventoId      String
  solicitanteId String
  tarifaId      String?
  numPersonas   Int
  funcion       String
  estado        String   @default("PENDIENTE")
  fechaInicioLabor DateTime?
  fechaFinLabor    DateTime?
  presupuesto   Float?
  costoTotal    Float?
  comentario    String?
  notaAdmin     String?
  aprobadoPorId String?
  aprobadoEn    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  evento      Evento    @relation(fields: [eventoId], references: [id])
  solicitante User      @relation(fields: [solicitanteId], references: [id])
  tarifa      Tarifa?   @relation(fields: [tarifaId], references: [id])
  aprobadoPor User?     @relation("SolicitudAprobador", fields: [aprobadoPorId], references: [id])

  asignaciones AsignacionAplicante[]

  @@map("solicitudes")
}

model Factura {
  id            String   @id @default(cuid())
  eventoId      String?
  creadoPorId   String
  responsable   String
  numeroFactura String?
  proveedor     String?
  rucDv         String?
  descripcion   String?
  fechaEmision  String?
  fechaPago     String?
  subtotal      Float    @default(0)
  itbms         Float    @default(0)
  total         Float    @default(0)
  archivoNombre String?
  tipoPago      String?  // CAJA_MENUDA | REEMBOLSO
  createdAt     DateTime @default(now())

  evento    Evento? @relation(fields: [eventoId], references: [id])
  creadoPor User    @relation(fields: [creadoPorId], references: [id])

  @@map("facturas")
}

model Puesto {
  id        String   @id @default(cuid())
  nombre    String
  tenantId  String?
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@map("puestos")
}

model Aplicante {
  id                  String    @id @default(cuid())
  nombreCompleto      String
  cedula              String    @unique
  telefono            String
  email               String    @unique
  cuentaBancaria      String
  banco               String?
  tipoCuenta          String?
  terminosAceptados   Boolean   @default(false)
  terminosAceptadosAt DateTime?
  qrSecret            String    @default(cuid())
  activo              Boolean   @default(true)
  passwordHash        String?
  debeCambiarPassword Boolean   @default(false) // true tras un restablecimiento por admin: debe elegir una nueva antes de usar el resto del portal
  noApto              Boolean   @default(false)
  motivoNoApto        String?
  fotoPersonal        String?
  fotoCedula          String?
  fotoConCedula       String?
  tenantId            String?
  createdAt           DateTime  @default(now())

  tenant       Tenant?               @relation(fields: [tenantId], references: [id])
  asignaciones AsignacionAplicante[]

  @@map("aplicantes")
}

// EstadoAsignacion: ACTIVA | COMPLETADA | CANCELADA
model AsignacionAplicante {
  id          String   @id @default(cuid())
  aplicanteId String
  eventoId    String
  solicitudId String
  funcion     String
  estado      String   @default("ACTIVA")
  createdAt   DateTime @default(now())

  aplicante Aplicante @relation(fields: [aplicanteId], references: [id])
  evento    Evento    @relation(fields: [eventoId], references: [id])
  solicitud Solicitud @relation(fields: [solicitudId], references: [id])
  registros RegistroAsistencia[]

  @@unique([aplicanteId, eventoId])
  @@map("asignaciones_aplicantes")
}

// TipoRegistro: ENTRADA | SALIDA
// Origen: QR (escaneado por un tercero) | SELF (autorregistro, ej. choferes)
model RegistroAsistencia {
  id           String   @id @default(cuid())
  asignacionId String
  tipo         String
  timestamp    DateTime @default(now())
  tokenUsado   String
  origen       String   @default("QR")
  lat          Float?
  lng          Float?

  asignacion AsignacionAplicante @relation(fields: [asignacionId], references: [id])

  @@unique([asignacionId, tipo, tokenUsado])
  @@map("registros_asistencia")
}

// Estado: PENDIENTE | APROBADA | RECHAZADA | RESPALDOS_ENTREGADOS | PAGADA
model CajaMenuda {
  id               String    @id @default(cuid())
  eventoId         String
  solicitanteId    String
  descripcion      String
  montoSolicitado  Float
  montoAprobado    Float?
  estado           String    @default("PENDIENTE")
  notaAdmin        String?
  aprobadoPorId    String?
  aprobadoEn       DateTime?
  pagadoPorId      String?
  pagadoEn         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  evento       Evento              @relation(fields: [eventoId], references: [id])
  solicitante  User                @relation(fields: [solicitanteId], references: [id])
  aprobadoPor  User?               @relation("CajaMenudaAprobador", fields: [aprobadoPorId], references: [id])
  pagadoPor    User?               @relation("CajaMenudaPagador",   fields: [pagadoPorId],   references: [id])
  facturas     FacturaCajaMenuda[]

  @@unique([solicitanteId, eventoId])
  @@map("cajas_menuda")
}

model FacturaCajaMenuda {
  id            String   @id @default(cuid())
  cajaMenudaId  String
  descripcion   String?
  proveedor     String?
  numeroFactura String?
  rucDv         String?
  fechaEmision  String?
  subtotal      Float    @default(0)
  itbms         Float    @default(0)
  total         Float    @default(0)
  archivoNombre String?
  archivoPath   String?
  createdAt     DateTime @default(now())

  cajaMenuda CajaMenuda @relation(fields: [cajaMenudaId], references: [id], onDelete: Cascade)

  @@map("facturas_caja_menuda")
}

// Ventas ya reconciliadas (filtroBancos = OK) del Reporte Showare de
// Panatickets. Sincronizado por el cron de finanzas para poder consultar por
// rango de fechas/año en vez de reprocesar el Excel completo (varios MB,
// crece a diario) en cada carga del dashboard. ordenId es el N° de orden de
// Showare — NO es único por fila (una orden puede tener varias líneas, ej.
// distintos tipos de boleto), así que es solo un campo de referencia/display,
// no la llave primaria. El sync reemplaza la tabla completa en cada corrida
// (ver syncFinanzasPanatickets) en vez de hacer upsert por id.
model PanaticketsVenta {
  id         Int      @id @default(autoincrement())
  ordenId    Int?
  fecha      String // YYYY-MM-DD
  hora       String?
  evento     String
  precio     Float
  cxs        Float
  spac       Float
  itbms      Float
  total      Float
  banco      String
  fechaAbono String
  estado     String
  updatedAt  DateTime @updatedAt

  @@index([fecha])
  @@map("panatickets_ventas")
}

model PanaticketsCancelada {
  id           Int      @id @default(autoincrement())
  ordenId      Int?
  fecha        String
  evento       String
  codigoPrecio String
  precio       Float
  cxs          Float
  total        Float
  updatedAt    DateTime @updatedAt

  @@index([fecha])
  @@map("panatickets_canceladas")
}

// Saldos Banco por día (uno por cada fila de la hoja con los bancos
// completos) — permite que el filtro "Día de compra" del dashboard también
// controle qué día de saldos se muestra, en vez de solo el más reciente.
// El sync reemplaza la tabla completa en cada corrida (mismo patrón que
// PanaticketsVenta).
model PanaticketsSaldoDia {
  fecha              String   @id // YYYY-MM-DD
  fechaDisplay       String   // dd/mm/yyyy tal como se muestra
  bancos             Json
  subtotalBancos     Float
  subtotalContable   Float
  subtotalDiferencia Float
  conceptos          Json
  updatedAt          DateTime @updatedAt

  @@map("panatickets_saldos_dia")
}

// Snapshot único (no histórico): pendientes de reconciliar "a hoy" y
// anticipos por evento — no vienen fechados por día en el Excel origen, así
// que se quedan como "estado actual", no por día. Se sobreescribe en cada
// sincronización del cron.
model PanaticketsSnapshot {
  id                 Int      @id @default(1)
  anticipos          Json
  totalAnticipo      Float
  globalSummary      Json
  costoPorServicio   Float    @default(0) // Hoja Reporte Showare: SUM(CXS) donde Filtro Showare="incluir" y Evento Activo="Activo"
  eventosPorLiquidar Float    @default(0) // misma selección: SUM(Total) - SUM(CXS)
  transitoTdc        Float    @default(0) // Hoja "En transito", fila TOTAL de la tabla "DETALLE POR DÍA", columna "Tránsito TDC/Otros"
  transitoAch        Float    @default(0) // Hoja "En transito", fila TOTAL de la tabla "DETALLE POR DÍA", columna "Tránsito ACH/Efec/Taq"
  generatedAt        DateTime

  @@map("panatickets_snapshot")
}

// ══════════════════════════════════════════════════════════════════════════
// Cotizador de Print Media PTY (tenant "printmediapty") — cotizaciones de
// venta a clientes de trabajos de impresión (banners, vinil, mesh, letreros),
// independiente del modelo Cotizacion/Presupuesto usado por Panatickets /
// Magic Dreams (que es para aprobar gastos dentro del presupuesto de un
// evento tipo concierto, un dominio distinto).

model MaterialPM {
  id            String   @id @default(cuid())
  tenantId      String?
  nombre        String
  unidad        String   // m², m, unidad, etc.
  costoUnitario Float    @default(0)
  activo        Boolean  @default(true)
  createdAt     DateTime @default(now())

  tenant  Tenant?            @relation(fields: [tenantId], references: [id])
  recetas ProductoMaterialPM[]

  @@map("materiales_pm")
}

// Fórmula de consumo del producto: AREA (ancho×alto) o AREA_PERIMETRO
// (ancho×alto + perímetro, ej. banners con cuerda/ojales en el borde).
model ProductoParametricoPM {
  id        String   @id @default(cuid())
  tenantId  String?
  nombre    String
  formula   String   @default("AREA")
  manoObra  Float    @default(0) // costo de mano de obra por m² de producto
  margenA   Float    @default(0) // % margen objetivo — nivel A (Premium)
  margenB   Float    @default(0) // % margen objetivo — nivel B (Regular)
  margenC   Float    @default(0) // % margen objetivo — nivel C (Al detal)
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())

  tenant    Tenant?              @relation(fields: [tenantId], references: [id])
  materiales ProductoMaterialPM[]
  items      ItemCotizacionPM[]

  @@map("productos_pm")
}

// Receta: cuánto consume un producto de un material, por m² de área y/o por
// metro de perímetro.
model ProductoMaterialPM {
  id                        String @id @default(cuid())
  productoId                String
  materialId                String
  cantidadPorM2             Float  @default(0)
  cantidadPorMetroPerimetro Float  @default(0)

  producto ProductoParametricoPM @relation(fields: [productoId], references: [id], onDelete: Cascade)
  material MaterialPM            @relation(fields: [materialId], references: [id])

  @@unique([productoId, materialId])
  @@map("producto_materiales_pm")
}

// Estado: PENDIENTE | APROBADA | RECHAZADA
// costoRealEstado (solo si estado=APROBADA): null (aún no se sube) | PENDIENTE | APROBADO | RECHAZADO
model CotizacionPM {
  id              String    @id @default(cuid())
  tenantId        String?
  nombreTrabajo   String    // ej. "Presupuesto de banner" — así se identifica dentro del evento
  clienteId       String?
  clienteNombre   String
  clienteContacto String?
  clienteTelefono String?
  clienteCorreo   String?
  nivelPrecio     String    @default("B") // A | B | C
  eventoId        String?
  vigenciaDias    Int       @default(15)
  carpetaDriveUrl String?
  notas           String?
  transporte           Float @default(0)
  costosIndirectosPct  Float @default(8)
  fechaEntrega    DateTime?
  estado          String    @default("PENDIENTE")
  notaAdmin       String?
  aprobadaPorId   String?
  aprobadaEn      DateTime?

  // Totales calculados (snapshot al guardar, para historial y resumen en el evento)
  montoVenta      Float @default(0)
  costoTotal      Float @default(0)
  utilidadBruta   Float @default(0)

  // Costo real (post-aprobación)
  costoRealTotal         Float?
  costoRealEstado        String?
  costoRealNotaAdmin     String?
  costoRealAprobadoPorId String?
  costoRealAprobadoEn    DateTime?
  costoRealSubidoEn      DateTime?

  creadoPorId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant               Tenant?    @relation(fields: [tenantId], references: [id])
  cliente              Cliente?   @relation(fields: [clienteId], references: [id])
  evento               Evento?    @relation(fields: [eventoId], references: [id])
  creadoPor            User       @relation("CotizacionPMCreador", fields: [creadoPorId], references: [id])
  aprobadaPor          User?      @relation("CotizacionPMAprobador", fields: [aprobadaPorId], references: [id])
  costoRealAprobadoPor User?      @relation("CotizacionPMCostoRealAprobador", fields: [costoRealAprobadoPorId], references: [id])
  items                ItemCotizacionPM[]
  facturasCostoReal    FacturaCotizacionPM[]

  @@map("cotizaciones_pm")
}

model ItemCotizacionPM {
  id                 String  @id @default(cuid())
  cotizacionId       String
  productoId         String?
  descripcion        String
  ancho              Float?
  alto               Float?
  cantidad           Int     @default(1)
  incluyeInstalacion Boolean @default(false)
  incluyeDiseno      Boolean @default(false)
  costoUnitario      Float   @default(0)
  precioUnitario     Float   @default(0)
  incluido           Boolean @default(true)
  orden              Int     @default(0)

  cotizacion CotizacionPM            @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)
  producto   ProductoParametricoPM?  @relation(fields: [productoId], references: [id])

  @@map("items_cotizacion_pm")
}

model FacturaCotizacionPM {
  id            String  @id @default(cuid())
  cotizacionId  String
  descripcion   String?
  proveedor     String?
  monto         Float   @default(0)
  archivoNombre String?
  archivoPath   String?

  cotizacion CotizacionPM @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)

  @@map("facturas_cotizacion_pm")
}

// Configuración por empresa (solo la edita el super-admin) de quién recibe
// el aviso de una nueva solicitud/cotización, quién puede aprobarla y quién
// recibe el aviso de la respuesta — para todos los flujos de aprobación del
// sistema (Solicitudes, Caja Menuda, Cotizaciones, Cotizador Print Media).
// Sin configuración para una empresa, cada flujo cae a su comportamiento
// previo (los ADMIN de esa empresa aprueban / reciben, el solicitante
// recibe la respuesta).
model AprobacionConfig {
  id        String   @id @default(cuid())
  tenantId  String   @unique
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  tenant   Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  usuarios AprobacionConfigUsuario[]

  @@map("aprobacion_configs")
}

// rol: RECEPTOR_SOLICITUD | APROBADOR | RECEPTOR_RESPUESTA
model AprobacionConfigUsuario {
  id       String @id @default(cuid())
  configId String
  userId   String
  rol      String

  config AprobacionConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([configId, userId, rol])
  @@map("aprobacion_config_usuarios")
}

